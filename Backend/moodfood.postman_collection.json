      ]
    },

    {
      "name": "💳 Payment",
      "item": [
        {
          "name": "Checkout — Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/payment/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 9.99,\n  \"orderType\": \"purchase\",\n  \"description\": \"MoodFood Premium\"\n}"
            }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/payment/orders"
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/payment/orders/<order-id>"
          }
        },
        {
          "name": "Refund Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/payment/orders/<order-id>/refund",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Customer request\"\n}"
            }
          }
        },
        {
          "name": "PayPal Success Callback (GET)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/payment/paypal/success?token=<paypal-order-token>",
              "query": [{ "key": "token", "value": "<paypal-order-token>" }]
            }
          }
        },
        {
          "name": "PayPal Cancel Callback (GET)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/payment/paypal/cancel?token=<paypal-order-token>",
              "query": [{ "key": "token", "value": "<paypal-order-token>" }]
            }
          }
        }
      ]
    },

