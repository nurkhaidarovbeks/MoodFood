    {
      "name": "🧪 Step-by-Step Test (полный флоу)",
      "description": "Запускай сверху вниз или через Collection Runner. Шаг 1 или 1b сохраняет {{token}} автоматически. Сервер должен быть запущен, рецепты засеяны.",
      "item": [
        {
          "name": "1. Register (saves token)",
          "event": [{ "listen": "test", "script": { "exec": [
            "var j = pm.response.json();",
            "if (j.token) pm.collectionVariables.set('token', j.token);",
            "pm.test('got token', () => pm.expect(pm.collectionVariables.get('token')).to.be.a('string').and.not.empty);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tester@moodfood.app\",\n  \"password\": \"SecurePass123!\",\n  \"name\": \"MoodFood Tester\"\n}"
            }
          }
        },
        {
          "name": "1b. Login (если уже зарегистрирован — saves token)",
          "event": [{ "listen": "test", "script": { "exec": [
            "var j = pm.response.json();",
            "if (j.token) pm.collectionVariables.set('token', j.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tester@moodfood.app\",\n  \"password\": \"SecurePass123!\"\n}"
