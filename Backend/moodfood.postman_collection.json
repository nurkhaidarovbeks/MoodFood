{
  "info": {
    "name": "MoodFood API — Full",
    "description": "Complete MoodFood backend collection. Import → set {{host}} variable if needed. Step-by-step folder runs top-to-bottom via Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "host",     "value": "https://moodfood-backend.onrender.com" },
    { "key": "base_url", "value": "{{host}}/api/v1" },
    { "key": "token",    "value": "" }
  ],
  "item": [

    {
      "name": "🟢 Health",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{host}}/health" }
        }
      ]
    },

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": [
            "var j = pm.response.json();",
            "if (j.token) pm.collectionVariables.set('token', j.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@moodfood.app\",\n  \"password\": \"SecurePass123!\",\n  \"name\": \"Alice\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "var j = pm.response.json();",
            "if (j.token) pm.collectionVariables.set('token', j.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@moodfood.app\",\n  \"password\": \"SecurePass123!\"\n}" }
          }
        },
        {
          "name": "Login — Wrong Password (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@moodfood.app\",\n  \"password\": \"wrongpassword\"\n}" }
          }
        },
        {
          "name": "Register — Duplicate Email (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@moodfood.app\",\n  \"password\": \"SecurePass123!\"\n}" }
          }
        },
        {
          "name": "OTP — Send Code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/otp/send",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@moodfood.app\"\n}" }
          }
        },
        {
          "name": "OTP — Verify Code (saves token)",
          "event": [{ "listen": "test", "script": { "exec": [
            "var j = pm.response.json();",
            "if (j.token) pm.collectionVariables.set('token', j.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/otp/verify",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@moodfood.app\",\n  \"code\": \"123456\"\n}" }
          }
        },
        {
          "name": "Apple Sign In",
          "event": [{ "listen": "test", "script": { "exec": [
            "var j = pm.response.json();",
            "if (j.token) pm.collectionVariables.set('token', j.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/apple",
            "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"<apple-id-token>\",\n  \"name\": \"Alice\"\n}" }
          }
        }
      ]
    },

    {
      "name": "👤 Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/profile"
          }
        },
        {
          "name": "Fill Profile (PUT — полный)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 22,\n  \"goal\": \"Eat healthier and feel more energetic\",\n  \"lifestyle\": \"student\",\n  \"budgetLevel\": \"low\",\n  \"dietaryRestrictions\": [],\n  \"allergies\": [],\n  \"customRestrictions\": []\n}"
            }
          }
        },
        {
          "name": "Patch Profile — только goal",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/profile",
            "body": { "mode": "raw", "raw": "{\n  \"goal\": \"Build muscle\"\n}" }
          }
        },
        {
          "name": "Fill Profile — vegan + nut allergy",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 25,\n  \"goal\": \"Stay light and healthy\",\n  \"lifestyle\": \"professional\",\n  \"budgetLevel\": \"medium\",\n  \"dietaryRestrictions\": [\"vegan\"],\n  \"allergies\": [\"nut_allergy\"],\n  \"customRestrictions\": [\"mushrooms\"]\n}"
            }
          }
        },
        {
          "name": "Get Profile — No Token (expect 401)",
          "request": { "method": "GET", "url": "{{base_url}}/profile" }
        }
      ]
    },

    {
      "name": "🥦 Pantry (Кладовка)",
      "item": [
        {
          "name": "Get My Ingredients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/pantry"
          }
        },
        {
          "name": "Add Ingredients",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/pantry",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ingredients\": [\"eggs\", \"rice\", \"tomato\", \"chicken breast\", \"rolled oats\", \"banana\"]\n}"
            }
          }
        },
        {
          "name": "Remove One Ingredient",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/pantry/<pantry-item-id>"
          }
        },
        {
          "name": "Clear Pantry",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/pantry/clear"
          }
        }
      ]
    },

    {
      "name": "🍽 Recipes",
      "item": [
        {
          "name": "List All Recipes",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/recipes"
          }
        },
        {
          "name": "List Recipes — Filter by Mood (energetic)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/recipes?mood=energetic&limit=10",
              "query": [
                { "key": "mood", "value": "energetic" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "List Recipes — Filter by Mood (tired)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/recipes?mood=tired",
              "query": [{ "key": "mood", "value": "tired" }]
            }
          }
        },
        {
          "name": "Get Recipe by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/recipes/<recipe-id>"
          }
        },
        {
          "name": "Create Recipe",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/recipes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Spinach Omelette\",\n  \"cookingTimeMin\": 10,\n  \"difficulty\": \"easy\",\n  \"estimatedCost\": 2.5,\n  \"calories\": 320,\n  \"proteinG\": 22,\n  \"steps\": \"Beat eggs, cook with spinach on medium heat.\",\n  \"moodTags\": [\"energetic\", \"happy\"],\n  \"ingredients\": [\n    { \"name\": \"eggs\", \"category\": \"dairy\", \"amount\": \"3\", \"unit\": \"pcs\" },\n    { \"name\": \"spinach\", \"category\": \"vegetable\", \"amount\": \"50\", \"unit\": \"g\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Recipe Recommendations (dietary filter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/recipes/recommendations"
          }
        },
        {
          "name": "Recipe Recommendations — By My Ingredients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/recipes/recommendations?useMyIngredients=true",
              "query": [{ "key": "useMyIngredients", "value": "true" }]
            }
          }
        },
        {
          "name": "Recipe Recommendations — Min 80% Match",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/recipes/recommendations?useMyIngredients=true&minMatchScore=0.8",
              "query": [
                { "key": "useMyIngredients", "value": "true" },
                { "key": "minMatchScore", "value": "0.8" }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "😊 Mood-Check (Epic 2)",
      "item": [
        {
          "name": "Create Mood-Check — Tired / Stressed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/mood-checks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mood\": \"tired\",\n  \"energyLevel\": 2,\n  \"stressLevel\": \"high\",\n  \"sleepQuality\": \"poor\",\n  \"hungerLevel\": \"high\"\n}"
            }
          }
        },
        {
          "name": "Create Mood-Check — Happy / Energetic",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/mood-checks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mood\": \"happy\",\n  \"energyLevel\": 5,\n  \"stressLevel\": \"low\",\n  \"sleepQuality\": \"good\",\n  \"hungerLevel\": \"medium\"\n}"
            }
          }
        },
        {
          "name": "Get Mood-Check History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/mood-checks?limit=20&offset=0",
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get Latest Mood-Check",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/mood-checks/latest"
          }
        },
        {
          "name": "Create — Empty Body (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/mood-checks",
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Create — No Token (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/mood-checks",
            "body": { "mode": "raw", "raw": "{\n  \"mood\": \"tired\",\n  \"energyLevel\": 2\n}" }
          }
        }
      ]
    },

