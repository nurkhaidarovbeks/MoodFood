            ],
            "url": "{{base_url}}/recommendations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mood\": \"tired\",\n  \"energyLevel\": 2,\n  \"stressLevel\": \"high\",\n  \"sleepQuality\": \"poor\",\n  \"hungerLevel\": \"high\",\n  \"maxCookingTime\": 20,\n  \"useMyIngredients\": true\n}"
            }
          }
