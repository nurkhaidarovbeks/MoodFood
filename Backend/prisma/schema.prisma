// MoodFood — Prisma Schema
// Database: PostgreSQL
// ORM: Prisma 5.x

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AuthProvider {
  email
  google
  apple
  telegram
}

enum OrderStatus {
  created
  pending
  paid
  fulfilled
  completed
  failed
  refunded
  cancelled
}

enum OrderType {
  purchase
  topup
  subscription
}

enum SubscriptionPlanType {
  monthly
  annual
}

enum SubscriptionStatus {
  pending
  active
  cancelled
  expired
}

enum PaymentGateway {
  bereke
  paypal
}

enum TransactionType {
  topup
  payment
  refund
}

enum Lifestyle {
  student
  professional
  other
}

enum BudgetLevel {
  low
  medium
  high
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id        String       @id @default(uuid())
  email     String       @unique
  name      String?

  // Auth
  passwordHash             String?
  authProvider             AuthProvider @default(email)
  googleId                 String?      @unique @map("google_id")
  appleId                  String?      @unique @map("apple_id")

  // Email verification
  isEmailVerified          Boolean      @default(false)
  emailVerificationToken   String?      // SHA-256 hash of raw token (raw token sent via email, never stored)
  emailVerificationExpires DateTime?

  // OTP — 6-digit code, valid 5 minutes, max 3 attempts
  otpHash     String?   @map("otp_hash")
  otpExpires  DateTime? @map("otp_expires")
  otpAttempts Int       @default(0) @map("otp_attempts")

  // Account state
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile           UserProfile?
  pantryIngredients UserIngredient[]
  orders            Order[]
  wallet            Wallet?
  subscriptions     UserSubscription[]

  @@map("users")
}

// ─── User Profiles ────────────────────────────────────────────────────────────

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Nutrition profile fields
  age         Int?
  goal        String?
  lifestyle   Lifestyle?
  budgetLevel BudgetLevel?

  // Dietary restrictions — stored as JSON arrays of string keys
  // e.g., ["vegan", "gluten_free"]
  dietaryRestrictions Json @default("[]")

  // Allergies — stored as JSON array of string keys
  // e.g., ["nut_allergy", "egg_allergy"]
  allergies Json @default("[]")

  // Free-text custom restrictions — stored as JSON array of lowercase strings
  // e.g., ["mushrooms", "cilantro"]
  customRestrictions Json @default("[]")

  // Profile completion tracking
  onboardingCompleted Boolean   @default(false)
  profileCompletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ─── Recipes ─────────────────────────────────────────────────────────────────

model Recipe {
  id             String  @id @default(uuid())
  title          String
  cookingTimeMin Int?
  difficulty     String?
  estimatedCost  Float?
  calories       Float?
  proteinG       Float?
  steps          String?

  // JSON array of mood tag strings, e.g., ["happy", "energetic"]
  moodTags Json @default("[]")

  recipeIngredients RecipeIngredient[]

  @@map("recipes")
}

// ─── Ingredients ─────────────────────────────────────────────────────────────

model Ingredient {
  id       String  @id @default(uuid())
  name     String  @unique
  category String? // e.g., "meat", "dairy", "vegetable" — used for restriction filtering

  recipeIngredients RecipeIngredient[]
  userIngredients   UserIngredient[]

  @@map("ingredients")
}

// ─── Recipe Ingredients (junction) ───────────────────────────────────────────

model RecipeIngredient {
  id           String @id @default(uuid())
  recipeId     String
  ingredientId String
  amount       String?
  unit         String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  amount         Float
  currency       String         @default("KZT")
  status         OrderStatus    @default(created)
  orderType      OrderType      @default(purchase) @map("order_type")
  gateway        PaymentGateway
  gatewayOrderId String?        @map("gateway_order_id")
  paymentUrl     String?        @map("payment_url")
  transactionId  String?        @map("transaction_id")
  description    String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletTx     WalletTransaction?
  subscription UserSubscription?

  @@map("orders")
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model SubscriptionPlan {
  id           String               @id @default(uuid())
  type         SubscriptionPlanType @unique
  name         String
  priceKzt     Float                @map("price_kzt")
  priceUsd     Float                @map("price_usd")
  durationDays Int                  @map("duration_days")
  description  String?
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  planId    String             @map("plan_id")
  orderId   String?            @unique @map("order_id")
  status    SubscriptionStatus @default(pending)
  startedAt DateTime?          @map("started_at")
  expiresAt DateTime?          @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan  SubscriptionPlan @relation(fields: [planId], references: [id])
  order Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("user_subscriptions")
}

// ─── Wallet ───────────────────────────────────────────────────────────────────

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Float    @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String          @id @default(uuid())
  walletId    String          @map("wallet_id")
  orderId     String?         @unique @map("order_id")
  amount      Float
  currency    String          @default("KZT")
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("wallet_transactions")
}

// ─── User Pantry (ingredients available at home) ──────────────────────────────

model UserIngredient {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  ingredientId String   @map("ingredient_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientId])
  @@map("user_ingredients")
}
