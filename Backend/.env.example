# ─────────────────────────────────────────────
# MoodFood Backend — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/moodfood?schema=public"

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-strong-random-secret-minimum-32-characters
JWT_EXPIRES_IN=7d

# Email Verification
# Set to "true" to enforce email verification before login.
# Set to "false" for MVP / development to skip enforcement.
REQUIRE_EMAIL_VERIFICATION=false

# SMTP — leave blank to use console stub in development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@moodfood.app

# App URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Google OAuth
# Create credentials at https://console.cloud.google.com/
# The client ID is used to verify Google ID tokens server-side.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign In
# The Bundle ID of your iOS/macOS app (e.g. com.moodfood.app).
# Used to verify Apple ID tokens server-side.
APPLE_CLIENT_ID=com.yourcompany.yourapp
