# ─────────────────────────────────────────────
# MoodFood Backend — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/moodfood?schema=public"

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-strong-random-secret-minimum-32-characters
JWT_EXPIRES_IN=7d

# Email Verification
# Set to "true" to enforce email verification before login.
# Set to "false" for MVP / development to skip enforcement.
REQUIRE_EMAIL_VERIFICATION=false

# SMTP — leave blank to use console stub in development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@moodfood.app

# App URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Google OAuth
# Create credentials at https://console.cloud.google.com/
# The client ID is used to verify Google ID tokens server-side.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign In
# The Bundle ID of your iOS/macOS app (e.g. com.moodfood.app).
# Used to verify Apple ID tokens server-side.
APPLE_CLIENT_ID=com.yourcompany.yourapp

# ─── PayPal ───────────────────────────────────────────────────────────────────
# Sandbox: developer.paypal.com → My Apps → Create App
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=https://moodfood-backend.onrender.com/api/v1/payment/paypal/success
PAYPAL_CANCEL_URL=https://moodfood-backend.onrender.com/api/v1/payment/paypal/cancel

# ─── Wallet (International) ───────────────────────────────────────────────────
# Sandbox: developer.paypal.com → My Apps → Create App
WALLET_CLIENT_ID=your_wallet_sandbox_client_id
WALLET_CLIENT_SECRET=your_wallet_sandbox_client_secret
WALLET_BASE_URL=https://api-m.sandbox.paypal.com
WALLET_RETURN_URL=https://moodfood-backend.onrender.com/api/v1/payment/wallet/success
WALLET_CANCEL_URL=https://moodfood-backend.onrender.com/api/v1/payment/wallet/cancel

# ─── Subscription (International) ──────────────────────────────────────────────
# Sandbox: developer.paypal.com → My Apps → Create App
SUBSCRIPTION_CLIENT_ID=your_subscription_sandbox_client_id
SUBSCRIPTION_CLIENT_SECRET=your_subscription_sandbox_client_secret
SUBSCRIPTION_BASE_URL=https://api-m.sandbox.paypal.com
SUBSCRIPTION_RETURN_URL=https://moodfood-backend.onrender.com/api/v1/payment/subscription/success
SUBSCRIPTION_CANCEL_URL=https://moodfood-backend.onrender.com/api/v1/payment/subscription/cancel
PAYPAL_CANCEL_URL=https://moodfood-backend.onrender.com/api/v1/payment/paypal/cancel

# ─── AI: Claude (Anthropic) — Epic 4 meal recommendation explanations ─────────
# Get a key at https://console.anthropic.com/ . Leave empty to run fully offline:
# the recommendation engine falls back to deterministic rule-based explanations.
ANTHROPIC_API_KEY=
# Default claude-haiku-4-5 (cheap & fast for short blurbs).
# Use claude-opus-4-8 or claude-sonnet-4-6 for higher-quality prose.
ANTHROPIC_MODEL=claude-haiku-4-5
