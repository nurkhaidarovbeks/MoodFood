# ─────────────────────────────────────────────
# MoodFood Backend — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0

# Database (PostgreSQL via Prisma)
# Local: postgresql://moodfood:moodfood_dev@localhost:5434/moodfood?schema=public
# Render: External Database URL from Render Dashboard → PostgreSQL → Info
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/moodfood?schema=public"

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-strong-random-secret-minimum-32-characters
JWT_EXPIRES_IN=30d

# Email Verification
# Set to "true" to enforce email verification before login.
# Set to "false" for MVP / development to skip enforcement.
REQUIRE_EMAIL_VERIFICATION=false

# SMTP — leave blank to use console stub in development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@moodfood.app

# App URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Google OAuth
# Create credentials at https://console.cloud.google.com/
# The client ID is used to verify Google ID tokens server-side.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign In
# The Bundle ID of your iOS/macOS app.
APPLE_CLIENT_ID=com.banb.moodfood

# ─── PayPal ───────────────────────────────────────────────────────────────────
# Sandbox: developer.paypal.com → My Apps → Create App
# Production: switch PAYPAL_BASE_URL to https://api-m.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=https://moodfood-backend.onrender.com/api/v1/payment/paypal/success
PAYPAL_CANCEL_URL=https://moodfood-backend.onrender.com/api/v1/payment/paypal/cancel

# ─── AI: OpenAI — meal recommendation explanations ───────────────────────────
# Get a key at https://platform.openai.com/api-keys
# Leave empty to run fully offline: falls back to deterministic rule-based explanations.
# ─── Grafana Cloud (production monitoring) ────────────────────────────────────
# grafana.com → free account → Stack → Send metrics → Remote Write URL + credentials
# Leave empty to skip (local Prometheus via docker-compose is used instead)
GRAFANA_REMOTE_WRITE_URL=
GRAFANA_REMOTE_WRITE_USER=
GRAFANA_REMOTE_WRITE_PASSWORD=

# gpt-4o-mini: cheap & fast for short blurbs (~$0.00015 per request).
# Override with gpt-4o for higher-quality prose.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vision model — photo ingredient recognition (fridge / receipt / shopping list).
# Requires OPENAI_API_KEY. gpt-4o-mini supports vision and is cheap; use gpt-4o
# for higher accuracy on blurry shelves or dense receipts. Without a key the
# /vision endpoints return 503 (there is no offline fallback for image analysis).
OPENAI_VISION_MODEL=gpt-4o-mini
